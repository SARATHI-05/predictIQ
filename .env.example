# PredictIQ Environment Configuration

# Database (Leave as sqlite for instant zero-config, or use mysql connection string)
DATABASE_URL=sqlite:///./predictiq.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/predictiq_db

# Security & JWT
SECRET_KEY=predictiq-super-secret-production-key-2026

# Server Port
PORT=8000
HOST=127.0.0.1

# Firebase Authentication Configuration (Get from Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend Firebase Project ID
FIREBASE_PROJECT_ID=
# FIREBASE_SERVICE_ACCOUNT_KEY=path/to/serviceAccountKey.json

# SMTP Email Configuration (For delivering 6-digit verification codes to user inboxes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=



